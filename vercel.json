{
  "rewrites": [
    {
      "source": "/((?!assets/|_vercel/|Madhav\\.jpg|My_Icon\\.png|Bewakoof_Logo\\.svg|Calculator\\.png|Dashboard\\.png|Madhav_Resume\\.pdf|Sugar_Black_Logo\\.png|Sugar_Logo\\.jpeg|Sugar_white_logo\\.png|User_Image\\.png|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.freelancing-portfolio-flax-seven.vercel.app"
        }
      ],
      "destination": "https://freelancing-portfolio-flax-seven.vercel.app/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
